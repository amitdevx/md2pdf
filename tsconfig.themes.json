{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "themes",
    "rootDir": "src/themes",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/themes/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/themes/loader.ts"]
}
