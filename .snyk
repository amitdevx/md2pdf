        created: 2026-10-31T07:12:09.763Z
  SNYK-JS-URIJS-19963961:
    - '*':
        reason: Dev dependency in ESLint 9
        expires: 2026-11-30T07:12:16.580Z
        created: 2026-10-31T07:12:16.590Z
  SNYK-JS-URIJS-20341609:
    - '*':
        reason: Dev dependency in ESLint 9
        expires: 2026-11-30T07:12:24.427Z
        created: 2026-10-31T07:12:24.433Z
  SNYK-JS-URIJS-19963963:
    - '*':
        reason: Dev dependency in ESLint 9
        expires: 2026-11-30T07:12:32.140Z
        created: 2026-10-31T07:12:32.147Z
  77b1d265-b163-42db-8404-da0394600512:
